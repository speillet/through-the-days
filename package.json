{
  "name": "through-the-days",
  "version": "0.0.0",
  "private": true,
  "description": "A private, offline-first macOS journal",
  "workspaces": [
    "apps/desktop"
  ],
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "dev": "npm run tauri --workspace @through-the-days/desktop -- dev",
    "dev:web": "npm run dev --workspace @through-the-days/desktop",
    "build": "npm run build --workspace @through-the-days/desktop",
    "build:mac": "npm run tauri --workspace @through-the-days/desktop -- build --bundles app",
    "test": "npm run test --workspace @through-the-days/desktop --",
    "test:e2e": "npm run test:e2e --workspace @through-the-days/desktop --",
    "test:rust": "cargo test --workspace --locked",
    "check": "npm run check --workspace @through-the-days/desktop",
    "openspec": "OPENSPEC_TELEMETRY=0 openspec",
    "spec:list": "OPENSPEC_TELEMETRY=0 openspec list",
    "spec:validate": "OPENSPEC_TELEMETRY=0 openspec validate --all --strict --no-interactive",
    "smoke:native": "npm run smoke:native --workspace @through-the-days/desktop"
  },
  "devDependencies": {
    "@fission-ai/openspec": "2.1.1",
    "prettier": "3.10.1"
  }
}
